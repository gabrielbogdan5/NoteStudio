{
  "name": "NoteStudio",
  "short_name": "NoteStudio",
  "description": "A beautifully crafted, offline-first notes app with rich text editor, multiple themes, and full offline support.",
  "lang": "en",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",

  "display_override": [
    "window-controls-overlay",
    "tabbed",
    "standalone",
    "minimal-ui"
  ],

  "tab_strip": {
    "home_tab": {
      "url": "/"
    },
    "new_tab_button": {
      "url": "/?new=1"
    }
  },

  "orientation": "any",
  "background_color": "#0f0a1e",
  "theme_color": "#0f0a1e",
  "dir": "ltr",
  "categories": ["productivity", "utilities"],
  "prefer_related_applications": false,

  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://notestudio.pages.dev/manifest.json",
      "id": "io.github.gabrielbogdan5.notestudio"
    }
  ],

  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",

  "launch_handler": {
    "client_mode": ["focus-existing", "auto"]
  },

  "handle_links": "preferred",

  "scope_extensions": [
    { "origin": "https://notestudio.pages.dev" }
  ],

  "share_target": {
    "action": "/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },

  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "text/plain": [".txt"],
        "text/html": [".html", ".htm"]
      }
    }
  ],

  "protocol_handlers": [
    {
      "protocol": "web+notestudio",
      "url": "/?note=%s"
    }
  ],

  "edge_side_panel": {
    "preferred_width": 400
  },

  "screenshots": [
    {
      "src": "screenshots/screenshot-dark-editor.jpg",
      "sizes": "1080x1920",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "NoteStudio on mobile"
    },
    {
      "src": "screenshots/screenshot-desktop.jpg",
      "sizes": "1920x1080",
      "type": "image/jpeg",
      "form_factor": "wide",
      "label": "NoteStudio on desktop"
    }
  ],

  "note_taking": {
    "new_note_url": "/"
  },

  "shortcuts": [
    {
      "name": "New Note",
      "short_name": "New",
      "description": "Create a new note",
      "url": "/?new=1",
      "icons": [
        {
          "src": "icon-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],

  "widgets": [
    {
      "name": "Quick Note",
      "short_name": "Note",
      "description": "Create a new note instantly from your desktop.",
      "tag": "quick-note",
      "url": "/?new=1",
      "type": "text/html",
      "auth": false,
      "multiple": false,
      "icons": [
        {
          "src": "icon-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],

  "icons": [
    {
      "src": "icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
