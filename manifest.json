{
  "name": "NoteStudio",
  "short_name": "NoteStudio",
  "description": "A beautifully crafted, offline-first notes app \u2014 rich text, folders, themes, PDF export. Built as a single HTML file.",
  "lang": "en",
  "id": "https://gabrielbogdan5.github.io/NoteStudio/",
  "start_url": "https://gabrielbogdan5.github.io/NoteStudio/",
  "scope": "https://gabrielbogdan5.github.io/NoteStudio/",
  "display": "standalone",
  "display_override": [
    "tabbed",
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#1a0a2e",
  "theme_color": "#7c3aed",
  "dir": "ltr",
  "categories": [
    "productivity",
    "utilities"
  ],
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://gabrielbogdan5.github.io/NoteStudio/manifest.json",
      "id": "app.notestudio.gabrielbogdan5"
    }
  ],
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  },
  "handle_links": "preferred",
  "share_target": {
    "action": "https://gabrielbogdan5.github.io/NoteStudio/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "text/plain": [
          ".txt"
        ],
        "text/html": [
          ".html"
        ]
      }
    }
  ],
